<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.tcghub.control" android:versionCode="17" android:versionName="2.0.7">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Resolve the same provider after an update or reboot; access still requires the user's SAF grant. -->
    <queries>
        <provider android:authorities="com.termux.documents"/>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_server"
        android:theme="@style/HubTheme" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security">
        <activity android:name=".PlatformActivity" android:exported="false"/>
        <activity android:name=".RemoteActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ServerActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".UpdateActivity" android:exported="false"/>
        <activity android:name=".ControlActivity" android:windowSoftInputMode="adjustResize" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
