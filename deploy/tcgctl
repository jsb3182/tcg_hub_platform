#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
umask 077
: "${PREFIX:?Run from Termux}"
svroot="$PREFIX/var/service"
release="${TCG_RELEASE_DIR:-$HOME/tcg-release}"
backups="$HOME/tcg-backups"
guest_script=/opt/tcg-hub/current/deploy/ubuntu.sh
engine_file="$PREFIX/var/lib/tcg-hub/db-engine"
native_state="$PREFIX/var/lib/tcg-hub-native"
native_script="$PREFIX/libexec/tcg-hub/native-db.sh"
guest_stop="$PREFIX/libexec/tcg-hub/stop-guest.py"
mkdir -p "$backups" "$HOME/tcg-import"
# setup-termux holds this same open file description across its management steps.
if [[ ! /proc/self/fd/9 -ef "$HOME/.tcg-control.lock" ]]; then exec 9>"$HOME/.tcg-control.lock"; fi
flock -n 9 || { echo 'Another TCG management command is active.' >&2; exit 1; }
engine=guest
if [[ -e $engine_file ]]; then
  engine=$(cat "$engine_file")
  [[ $engine == guest || $engine == native ]] || { echo 'Invalid saved database engine.' >&2; exit 1; }
fi
guest() {
  proot-distro login ubuntu-tcg --isolated --user "$1" -- "${@:2}"
}
native_db() { "$PREFIX/bin/bash" "$native_script" "$@"; }
choose_engine() {
  local requested=${TCG_DB_ENGINE:-} old_data
  [[ -z $requested || $requested == guest || $requested == native ]] || { echo 'TCG_DB_ENGINE must be guest or native.' >&2; return 2; }
  if [[ -e $engine_file ]]; then
    [[ -z $requested || $requested == "$engine" ]] || { echo 'An existing database engine is already selected.' >&2; return 1; }
    [[ $engine == native ]] || return 0
  fi
  old_data=$(guest root /bin/sh -ec 'dir=/var/lib/postgresql/tcg-hub; if [ -d "$dir" ]; then find "$dir" -mindepth 1 -print -quit; fi')
  if [[ ! -e $engine_file ]]; then
    if [[ -n $requested ]]; then engine=$requested
    elif [[ -n $old_data || -e $svroot/tcg-db/run ]]; then engine=guest
    elif [[ ${TERMUX_VERSION:-} == googleplay.* || ${TERMUX_APK_RELEASE:-} == GOOGLE_PLAY_STORE ]]; then engine=native
    fi
  fi
  if [[ $engine == native ]]; then
    [[ -z $old_data ]] || { echo 'The Ubuntu data directory contains files. Preserve the existing database and use a logical migration.' >&2; return 1; }
    if [[ -e $native_state/data ]]; then
      [[ -s $native_state/data/PG_VERSION && -s $native_state/auth/postgres.pw ]] &&
        guest root /bin/sh -ec 'test -s /etc/tcg-hub/runtime.env && test -s /etc/tcg-hub/postgres.pw' || {
          echo 'Existing native data requires its original Termux and Ubuntu database credentials.' >&2; return 1;
        }
    fi
    if [[ -e $svroot/tcg-db/run ]] && ! grep -Fq "$native_script" "$svroot/tcg-db/run"; then
      [[ -e $svroot/tcg-db/down ]] || { echo 'Stop the previous database service with tcgctl stop first.' >&2; return 1; }
      if [[ -p $svroot/tcg-db/supervise/control ]]; then sv -w 60 stop "$svroot/tcg-db"; fi
    fi
  elif [[ -e $native_state/data ]]; then
    echo 'A native data directory already exists. Check its database engine before continuing.' >&2; return 1
  fi
}
install_native() {
  local package status
  for package in postgresql postgis; do
    status=$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null) || status=''
    if [[ $status != 'install ok installed' ]]; then
      [[ ! -e $native_state/data ]] || { echo 'Existing native cluster needs matching PostgreSQL and PostGIS packages.' >&2; return 1; }
      pkg install -y postgresql postgis
      break
    fi
  done
  install -d -m 0700 "$native_state" "$native_state/auth" "$(dirname "$native_script")"
  [[ ! -e $native_state/data || -s $native_state/auth/postgres.pw ]] || { echo 'Existing native cluster requires its original private password.' >&2; return 1; }
  local tmp
  tmp=$(mktemp "${native_script}.XXXXXX")
  install -m 0700 "$release/deploy/native-db.sh" "$tmp"
  mv -f "$tmp" "$native_script"
  proot-distro login ubuntu-tcg --isolated --bind "$native_state/auth:/mnt/tcg-auth" -- /bin/bash "$guest_script" native-auth
  native_db init
  dpkg-query -W postgresql postgis
}
prepare_db() {
  if [[ $engine == native ]]; then native_db ready; fi
  guest root /bin/bash "$guest_script" prepare-db
}
write_native_service() {
  local dir=$1 op target tmp
  mkdir -p "$dir/control"
  for op in run stop; do
    if [[ $op == run ]]; then target="$dir/run"; else target="$dir/control/t"; fi
    tmp=$(mktemp "${target}.XXXXXX")
    printf '#!%s/bin/sh\nexec 2>&1\nexec "%s/bin/bash" "%s" "%s"\n' "$PREFIX" "$PREFIX" "$native_script" "$op" > "$tmp"
    chmod 0700 "$tmp"
    mv -f "$tmp" "$target"
  done
}
install_guest_controls() {
  local svc dir tmp
  [[ -x $PREFIX/bin/python && -r $release/deploy/stop-guest.py ]] || {
    echo 'Guest controls require Termux python and deploy/stop-guest.py in the release.' >&2; return 1
  }
  install -d -m 0700 "$(dirname "$guest_stop")"
  tmp=$(mktemp "${guest_stop}.XXXXXX")
  install -m 0600 "$release/deploy/stop-guest.py" "$tmp"
  mv -f "$tmp" "$guest_stop"
  for svc in worker api tunnel; do
    dir="$svroot/tcg-$svc"
    [[ -x $dir/run ]] || { echo "Missing tcg-$svc service." >&2; return 1; }
    mkdir -p "$dir/control"
    tmp=$(mktemp "$dir/control/.t.XXXXXX")
    printf '#!%s/bin/sh\nexec "%s/bin/python" "%s" "%s"\n' "$PREFIX" "$PREFIX" "$guest_stop" "$svc" > "$tmp"
    chmod 0700 "$tmp"
    mv -f "$tmp" "$dir/control/t"
  done
}
stop_service() {
  local wait_seconds=60
  # Let active HTTP reads reach their timeout and complete rollback at a batch boundary.
  if [[ $1 == worker ]]; then wait_seconds=180; fi
  sv -w "$wait_seconds" stop "$svroot/tcg-$1"
}
ensure_supervisor() {
  local boot="$HOME/.termux/boot/30-tcg-services" n
  local services=("$svroot/tcg-db" "$svroot/tcg-api" "$svroot/tcg-worker" "$svroot/tcg-tunnel")
  if sv status "${services[@]}" >/dev/null 2>&1; then return 0; fi
  [[ -x $boot ]] || { echo 'The installed TCG boot hook is missing. Check the Termux installation.' >&2; return 1; }
  # Use Termux's service-daemon; it owns runsvdir and handles repeat invocations.
  # Its descendants must not inherit the operator lock when a start follows reboot.
  (exec 9>&-; bash "$boot") || return 1
  for ((n=0; n<20; n++)); do
    if sv status "${services[@]}" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  echo 'Termux service supervision is unavailable. Check termux-services in Termux.' >&2
  return 1
}
enable() {
  rm -f "$svroot/tcg-$1/down" && sv up "$svroot/tcg-$1"
}
disable() {
  touch "$svroot/tcg-$1/down"
  stop_service "$1"
}
edge_ready() {
  curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:20241/ready 2>/dev/null |
    python -c 'import json, sys; r = json.load(sys.stdin); sys.exit(not (r["status"] == 200 and r["readyConnections"] > 0))' 2>/dev/null
}
wait_for_edge() {
  local deadline=$((SECONDS + 60))
  until edge_ready; do
    (( SECONDS < deadline )) || return 1
    sleep 2
  done
}
start_public_tunnel() {
  local was_disabled=false
  if [[ -e $svroot/tcg-tunnel/down ]]; then was_disabled=true; fi
  if enable tunnel && wait_for_edge; then
    if guest tcgtunnel /bin/bash "$guest_script" check-public-route; then
      return 0
    elif [[ $? == 3 ]]; then
      echo 'Connector is up. Finish the challenged routes in a browser on an external connection.' >&2
      return 0
    fi
    echo 'Check the public hostname, DNS and Cloudflare Access/WAF routes.' >&2
  else
    echo "Cloudflare connection could not be confirmed. See $PREFIX/var/log/tcg-tunnel/current." >&2
  fi
  if [[ $was_disabled == true ]]; then disable tunnel; fi
  return 1
}
hold_writers() {
  local member
  local writers=(tunnel worker api)
  # A restarted runsv must see all writers disabled before supervising any of them.
  for member in "${writers[@]}"; do touch "$svroot/tcg-$member/down"; done
  ensure_supervisor
  for member in "${writers[@]}"; do stop_service "$member"; done
}
add_service() {
  local svc=$1 user=$2 path="$svroot/tcg-$1" log="$PREFIX/var/log/tcg-$1"
  if [[ -d $path ]]; then return; fi
  local staged
  staged=$(mktemp -d "$svroot/.tcg-$svc.XXXXXX")
  mkdir -p "$staged/log" "$log"
  touch "$staged/down"
  printf 's1048576\nn4\n' > "$log/config"
  cat > "$staged/run" <<RUN
#!$PREFIX/bin/sh
exec 2>&1
exec "$PREFIX/bin/proot-distro" login ubuntu-tcg --isolated --user "$user" -- /bin/bash "$guest_script" "$svc"
RUN
  cat > "$staged/log/run" <<RUN
#!$PREFIX/bin/sh
exec "$PREFIX/bin/svlogd" -tt "$log"
RUN
  chmod 0700 "$staged/run" "$staged/log/run"
  if [[ $svc == db ]]; then
    mkdir -p "$staged/control"
    cat > "$staged/control/t" <<RUN
#!$PREFIX/bin/sh
exec "$PREFIX/bin/proot-distro" login ubuntu-tcg --isolated --user postgres -- /usr/lib/postgresql/16/bin/pg_ctl -D /var/lib/postgresql/tcg-hub -m fast -w -t 45 stop
RUN
    chmod 0700 "$staged/control/t"
  fi
  mv -T "$staged" "$path"
}
cmd=${1:-help}
shift || true
case "$cmd" in
  install)
    for member in api worker tunnel; do
      [[ ! -d $svroot/tcg-$member || -e $svroot/tcg-$member/down ]] || {
        echo 'Make a backup and run tcgctl maintenance before upgrading.' >&2; exit 1;
      }
    done
    choose_engine
    model_bind=()
    if [[ -n ${TCG_TRANSLATION_MODEL_SOURCE:-} ]]; then
      [[ -d $TCG_TRANSLATION_MODEL_SOURCE ]] || { echo 'Missing offline translation model directory.' >&2; exit 1; }
      model_bind=(--bind "$TCG_TRANSLATION_MODEL_SOURCE:/mnt/tcg-translation-model")
    fi
    proot-distro login ubuntu-tcg --isolated --bind "$release:/mnt/tcg-release" "${model_bind[@]}" -- /usr/bin/env "TCG_DB_ENGINE=$engine" /bin/bash /mnt/tcg-release/deploy/install-ubuntu.sh "$@"
    if [[ $engine == native ]]; then install_native; fi
    install -d -m 0700 "$(dirname "$engine_file")"
    marker_tmp=$(mktemp "${engine_file}.XXXXXX")
    printf '%s\n' "$engine" > "$marker_tmp"
    mv -f "$marker_tmp" "$engine_file"
    mkdir -p "$HOME/.termux/boot" "$svroot"
    for member in db:postgres api:tcgapp worker:tcgapp tunnel:tcgtunnel; do
      add_service "${member%:*}" "${member#*:}"
    done
    if [[ $engine == native ]]; then write_native_service "$svroot/tcg-db"; fi
    install_guest_controls
    cat > "$HOME/.termux/boot/30-tcg-services" <<BOOT
#!$PREFIX/bin/sh
termux-wake-lock
. "$PREFIX/etc/profile.d/start-services.sh"
BOOT
    chmod 0700 "$HOME/.termux/boot/30-tcg-services"
    (exec 9>&-; bash "$HOME/.termux/boot/30-tcg-services")
    for (( n=0; n<20; n++ )); do
      if [[ -p $svroot/tcg-db/supervise/control ]]; then break; fi
      sleep 1
    done
    enable db
    prepare_db
    bash "$release/deploy/install-mobile-control.sh"
    completed=$(mktemp "$(dirname "$engine_file")/installed.XXXXXX")
    sha256sum "$release/MANIFEST.sha256" | cut -c1-20 > "$completed"
    mv -f "$completed" "$(dirname "$engine_file")/installed-manifest"
    echo 'Database prepared. Use tcgctl start-local for local access or restore a backup first.'
    ;;
  service-controls) install_guest_controls ;;
  check-public) guest tcgtunnel /bin/bash "$guest_script" check-public-route ;;
  token)
    read -rsp 'Cloudflare tunnel token: ' token
    echo
    [[ -n $token ]] || exit 2
    printf '%s' "$token" | guest root /bin/bash -c 'set -e; umask 077; tmp=$(mktemp /etc/tcg-hub/token.XXXXXX); cat > "$tmp"; chown tcgtunnel:tcgtunnel "$tmp"; mv -f "$tmp" /etc/tcg-hub/tunnel.token'
    ;;
  x-token)
    read -rsp 'Official X API bearer token: ' token
    echo
    [[ -n $token ]] || exit 2
    printf '%s' "$token" | guest root /bin/bash -c 'set -e; umask 077; tmp=$(mktemp /etc/tcg-hub/xtoken.XXXXXX); cat > "$tmp"; chown tcgapp:tcgapp "$tmp"; mv -f "$tmp" /etc/tcg-hub/x.token'
    echo 'Restart the worker to load its new token.'
    ;;
  configure-public)
    for member in tunnel api worker; do
      [[ -f $svroot/tcg-$member/down ]] || { echo 'Run tcgctl maintenance before changing the public origin.' >&2; exit 1; }
    done
    guest root /bin/bash "$guest_script" configure-public "$@"
    echo 'Access settings saved. Use tcgctl token and tcgctl start to enable the tunnel.'
    ;;
  start|start-local)
    guest root test ! -e /var/lib/tcg-hub/restore-in-progress || { echo 'Finish the pending restore first.' >&2; exit 1; }
    if [[ $cmd == start ]]; then
      guest tcgtunnel /bin/bash "$guest_script" check-public
    else
      # Preserve local mode even while an absent supervisor is being started.
      touch "$svroot/tcg-tunnel/down"
    fi
    ensure_supervisor
    if [[ $cmd == start-local ]]; then
      disable tunnel
    fi
    enable db
    prepare_db
    enable api
    for (( n=0; n<120; n++ )); do
      if curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:8080/internal/ready >/dev/null 2>&1; then break; fi
      sleep 2
    done
    curl --noproxy '*' -fsS --max-time 4 http://127.0.0.1:8080/internal/ready >/dev/null
    if [[ $cmd == start ]]; then guest tcgtunnel /bin/bash "$guest_script" check-public-origin; fi
    enable worker
    if [[ $cmd == start ]]; then start_public_tunnel; fi
    ;;
  status)
    echo "Database engine: $engine"
    for member in db api worker tunnel; do sv status "$svroot/tcg-$member"; done
    if [[ ! -e $svroot/tcg-tunnel/down ]]; then
      if edge_ready; then echo 'Cloudflare connector is connected.'; else echo 'Cloudflare connection has not been confirmed.'; fi
    fi
    ;;
  maintenance) hold_writers;;
  stop) hold_writers; disable db;;
  account) guest tcgapp /bin/bash "$guest_script" account "$@";;
  admin-setup)
    [[ $# == 0 && -t 0 && -t 1 && -t 2 ]] || { echo 'Run tcgctl admin-setup in Termux.' >&2; exit 2; }
    guest tcgapp /bin/bash "$guest_script" admin-setup
    ;;
  password)
    [[ $# == 1 && -t 0 && -t 1 ]] || { echo 'Run tcgctl password EMAIL in Termux.' >&2; exit 2; }
    guest tcgapp /bin/bash "$guest_script" password "$@"
    ;;
  totp)
    [[ ( $# == 1 || ( $# == 2 && $2 == --rotate ) ) && -t 0 && -t 1 && -t 2 ]] || {
      echo 'Run tcgctl totp EMAIL [--rotate] interactively in Termux.' >&2; exit 2
    }
    guest tcgapp /bin/bash "$guest_script" totp "$@"
    ;;
  media) proot-distro login ubuntu-tcg --isolated --user tcgapp --bind "$HOME/tcg-import:/mnt/tcg-source" -- /bin/bash "$guest_script" media "$@";;
  backup|backup-for-update)
    backup_guest=()
    backup_args=()
    if [[ $cmd == backup-for-update ]]; then
      [[ $# == 1 && $1 =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || exit 2
      for member in api worker tunnel; do [[ -f $svroot/tcg-$member/down ]] || exit 1; done
      # This also supports updating a server stopped before the upgrade.
      enable db
      prepare_db
      backup_guest=(--bind "$release:/mnt/tcg-release")
      guest_script=/mnt/tcg-release/deploy/ubuntu.sh
      backup_args=(--name "$1")
    fi
    members=()
    for member in api worker tunnel; do
      if [[ ! -e $svroot/tcg-$member/down ]]; then members+=("$member"); fi
    done
    resume() { for member in "${members[@]}"; do sv up "$svroot/tcg-$member" || true; done; }
    trap resume EXIT
    for member in tunnel worker api; do stop_service "$member"; done
    if [[ $engine == native ]]; then
      work=$(mktemp -d "$native_state/.dump.XXXXXX")
      trap 'rm -rf -- "$work"; resume' EXIT
      native_db dump "$work/db.dump"
      proot-distro login ubuntu-tcg --isolated "${backup_guest[@]}" --bind "$backups:/mnt/tcg-backups" --bind "$work:/mnt/tcg-native" -- /bin/bash "$guest_script" backup --native "${backup_args[@]}"
    else
      proot-distro login ubuntu-tcg --isolated "${backup_guest[@]}" --bind "$backups:/mnt/tcg-backups" -- /bin/bash "$guest_script" backup "${backup_args[@]}"
    fi
    ;;
  restore)
    for member in tunnel worker api; do
      [[ -e $svroot/tcg-$member/down ]] || { echo 'Use tcgctl maintenance before restore.' >&2; exit 1; }
      stop_service "$member"
    done
    restore_guest() { proot-distro login ubuntu-tcg --isolated --bind "$backups:/mnt/tcg-backups" -- /bin/bash "$guest_script" "$@"; }
    if [[ $engine == native ]]; then
      [[ $# == 1 && $1 =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]] || { echo 'Expected a backup directory name.' >&2; exit 2; }
      restore_guest restore-stage "$1"
      native_db restore "$backups/$1/db.dump"
      restore_guest restore-finish "$1"
    else
      restore_guest restore "$@"
    fi
    ;;
  *) echo 'tcgctl install [--local]|service-controls|configure-public|check-public|token|x-token|start-local|start|status|maintenance|stop|account|admin-setup|password|totp|media|backup|restore'; exit 2;;
esac
